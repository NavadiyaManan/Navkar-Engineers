---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Navkar Engineers | Premium Elevator Components",
  description = "Navkar Engineers manufactures premium, high-end elevator components including Elevator Push Buttons, Landing Operating Panels (L.O.P.), and Car Operating Panels (C.O.P.) for global markets."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@400;500;600;700;800;900&display=swap" 
      rel="stylesheet" 
    />
  </head>
  <body class="bg-brand-dark text-brand-light font-sans selection:bg-brand-gold selection:text-brand-dark antialiased">
    <div class="relative min-h-screen flex flex-col justify-between overflow-x-hidden bg-grid-pattern">
      <!-- Glow effects in background -->
      <div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-brand-gold/5 rounded-full blur-[120px] pointer-events-none -z-10"></div>
      <div class="absolute bottom-1/4 right-1/4 w-[600px] h-[600px] bg-brand-gold/5 rounded-full blur-[150px] pointer-events-none -z-10"></div>
      
      <slot />

      <!-- Floating WhatsApp Chat Button -->
      <a 
        href="https://wa.me/917383881211?text=Hello%20Navkar%20Engineers,%20I%20am%20interested%20in%20your%20elevator%20components%20and%20would%20like%20to%20request%20more%20information." 
        target="_blank" 
        rel="noopener noreferrer" 
        class="fixed bottom-6 right-6 z-50 group flex items-center justify-center w-14 h-14 bg-[#25D366] hover:bg-[#20ba59] text-white rounded-full shadow-lg shadow-black/30 hover:shadow-[#25D366]/20 transition-all duration-300 hover:-translate-y-1"
        aria-label="Chat with Navkar Engineers on WhatsApp"
      >
        <!-- Outer pulsing rings for attention -->
        <span class="absolute inline-flex h-full w-full rounded-full bg-[#25D366]/40 animate-ping opacity-75"></span>
        <span class="absolute inline-flex h-full w-full rounded-full bg-brand-gold/20 animate-pulse"></span>
        
        <!-- WhatsApp Icon (SVG) -->
        <svg class="w-8 h-8 relative z-10 transition-transform duration-300 group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.458 5.705 1.459h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
      </a>
    </div>
  </body>
</html>
