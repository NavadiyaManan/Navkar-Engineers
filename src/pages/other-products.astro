---
// other-products.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const otherProducts = [
  {
    title: "TFT & Dot-Matrix Scroll Displays",
    image: "/images/other-products/display.png",
    description: "Sleek, high-contrast floor indicator displays. Supports custom layout sizes, dual-color LED configurations, scroll animations, and full CANbus serial communication overlays.",
    specifications: [
      { label: "Display Core", value: "High-contrast TFT / LED Dot-Matrix" },
      { label: "Connectivity", value: "CANbus / RS485 / Binary / BCD" },
      { label: "Color Options", value: "Warm Gold, Ice White, Amber" },
      { label: "Bezel Material", value: "SUS304 Stainless Steel" }
    ]
  },
  {
    title: "Security Locks & Key Switches",
    image: "/images/other-products/key_switch.png",
    description: "Heavy-duty keyed override mechanisms designed for elevator operation safety. Attendant call, fireman override, emergency stop, and custom key profiling options.",
    specifications: [
      { label: "Lock Profiles", value: "Attendant Recall, Fireman Override, Stop" },
      { label: "Contact Rating", value: "5A, 250VAC resistive load" },
      { label: "Operational Life", value: "> 1,000,000 Key Rotations" },
      { label: "Compliance Standard", value: "CE / EN 81-70 accessibility code" }
    ]
  },
  {
    title: "Auto-Door Safety Light Curtains",
    image: "/images/other-products/door_sensor.png",
    description: "Multi-beam infrared safety sensor strips preventing elevator door entrapment. Features ultra-fast reaction times, long-range alignment, and premium dust/water proofing.",
    specifications: [
      { label: "Beams Layout", value: "94 crossed beams / 154 active beams" },
      { label: "Response Timing", value: "< 50 ms trigger-to-stop time" },
      { label: "Ingress Protection", value: "IP65 Waterproof Profile" },
      { label: "Structure Depth", value: "9mm ultra-thin mounting rail" }
    ]
  },
  {
    title: "Top-of-Car Inspection Boxes",
    image: "/images/other-products/inspection_box.png",
    description: "Engineering control units mounted on top of elevator cabins for maintenance override. Houses emergency stop buttons, run control switches, and test sockets.",
    specifications: [
      { label: "Enclosure Material", value: "Heavy-duty ABS (Impact-resistant Yellow)" },
      { label: "Controls Installed", value: "Emergency Stop, Run/Stop, Hand/Auto" },
      { label: "Auxiliary Ports", value: "Dual international sockets & serial ports" },
      { label: "Compliance Standard", value: "EN 81-20 safety requirements" }
    ]
  }
];
---

<Layout 
  title="Other Elevator Products | Navkar Engineers - Elevator Components" 
  description="Explore Navkar Engineers' auxiliary elevator components including scrolling displays, safety door light curtains, key switches, and cabin control boxes."
>
  <!-- Global Navigation Header -->
  <Navbar />

  <main class="bg-brand-dark min-h-screen">
    
    <!-- Hero Banner Section -->
    <section class="relative py-20 bg-brand-charcoal border-b border-white/5 bg-grid-pattern overflow-hidden">
      <!-- Glow effect -->
      <div class="absolute top-1/2 left-1/2 w-[600px] h-[300px] -translate-x-1/2 -translate-y-1/2 bg-brand-gold/5 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative text-center space-y-4">
        <!-- Breadcrumbs -->
        <div class="flex items-center justify-center gap-2 text-[10px] text-brand-light/40 uppercase tracking-widest font-semibold">
          <a href="/" class="hover:text-brand-gold transition-colors">Home</a>
          <span>&gt;&gt;</span>
          <span class="text-brand-gold">Other Products</span>
        </div>
        
        <h1 class="text-4xl sm:text-5xl font-display font-extrabold text-white tracking-tight leading-tight uppercase">
          Other <span class="text-gold-metallic">Elevator Products</span>
        </h1>
        <p class="text-sm sm:text-base text-brand-light/70 max-w-xl mx-auto font-light leading-relaxed">
          Complementary engineering systems, display scrolls, safety light curtains, security switches, and maintenance control modules.
        </p>
        <div class="h-1 w-16 bg-brand-gold mx-auto mt-4"></div>
      </div>
    </section>

    <!-- Product Showcase Grid -->
    <section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        {otherProducts.map((product) => (
          <div class="group flex flex-col bg-brand-charcoal border border-white/5 overflow-hidden transition-all duration-500 hover:border-brand-gold/45 hover:shadow-[0_15px_30px_rgba(0,0,0,0.6)]">
            
            <!-- Graphic / Image Box -->
            <div class="relative aspect-[16/10] w-full overflow-hidden bg-brand-dark">
              <div class="absolute inset-0 bg-brand-dark/20 z-10 group-hover:bg-transparent transition-colors duration-500"></div>
              <img 
                src={product.image} 
                alt={product.title} 
                class="w-full h-full object-cover grayscale contrast-110 group-hover:grayscale-0 group-hover:scale-[1.03] group-hover:contrast-100 transition-all duration-750 ease-out"
                loading="lazy"
              />
            </div>

            <!-- Content Panel -->
            <div class="p-8 flex-1 flex flex-col justify-between space-y-6">
              <div class="space-y-4">
                <h3 class="font-display font-bold text-xl text-white tracking-wide group-hover:text-brand-gold transition-colors duration-300">
                  {product.title}
                </h3>
                <p class="text-xs text-brand-light/75 font-light leading-relaxed">
                  {product.description}
                </p>

                <!-- Technical Specs table -->
                <div class="pt-4">
                  <div class="border-t border-white/5 divide-y divide-white/5 text-[11px] font-sans">
                    {product.specifications.map((spec) => (
                      <div class="py-2 flex justify-between gap-4">
                        <span class="text-brand-light/40 font-light">{spec.label}</span>
                        <span class="text-white font-medium text-right">{spec.value}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Button -->
              <div class="pt-4">
                <a 
                  href="/#contact" 
                  class="w-full btn-chevron-hover inline-flex items-center justify-center py-3 bg-transparent border border-white/10 hover:border-brand-gold text-brand-light hover:text-brand-dark hover:bg-brand-gold font-display text-xs font-bold tracking-widest uppercase transition-all duration-300 focus:outline-none"
                >
                  <span>Request Technical Specifications</span>
                  <span class="chevron-icon ml-2 text-sm font-bold">&gt;&gt;</span>
                </a>
              </div>
            </div>

          </div>
        ))}
      </div>

    </section>

    <!-- Custom RFQ Consultation Banner -->
    <section class="py-20 bg-brand-charcoal overflow-hidden border-t border-white/5 relative bg-grid-pattern">
      <div class="absolute bottom-0 left-10 w-[400px] h-[400px] bg-brand-gold/3 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
        <h2 class="font-display font-semibold text-xs text-brand-gold uppercase tracking-widest">Custom Auxiliary Manufacturing</h2>
        <p class="font-display font-extrabold text-3xl text-white tracking-tight leading-tight">
          Request Custom System Designs
        </p>
        <p class="text-xs sm:text-sm text-brand-light/65 leading-relaxed font-light max-w-xl mx-auto">
          Need custom inspection boxes, unique faceplates, or special indicator mounting configurations? Our R&D team can engineer tailored solutions mapping to your schematic drawings.
        </p>
        <div class="pt-4">
          <a 
            href="/#contact" 
            class="btn-chevron-hover inline-flex items-center justify-center px-8 py-4 bg-gold-metallic text-brand-dark font-display font-bold text-xs tracking-widest uppercase transition-transform hover:-translate-y-0.5 focus:outline-none"
          >
            <span>Inquire B2B Custom Engineering</span>
            <span class="chevron-icon ml-2 text-sm font-bold">&gt;&gt;</span>
          </a>
        </div>
      </div>
    </section>

  </main>

  <!-- Global Footer -->
  <Footer />
</Layout>
