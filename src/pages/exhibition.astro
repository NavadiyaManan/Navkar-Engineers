---
// exhibition.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const exhibitions = [
  {
    title: "ELEVATE International Expo 2025",
    location: "Mumbai, India",
    year: "2025",
    tag: "Global Showcase",
    image: "/images/exhibition/booth_1.png",
    description: "Unveiled our flagship line of titanium-finish C.O.P. columns and CANbus L.O.P. panels. Witnessed strong interest from global real estate developers and elevator contractors."
  },
  {
    title: "International Lift Expo 2024",
    location: "Munich, Germany",
    year: "2024",
    tag: "Continental Expo",
    image: "/images/exhibition/booth_2.png",
    description: "Showcased our accessibility-ready, EN 81-70 compliant tactile buttons and flush-mount wall fixtures. Strengthened our partnership network across Western Europe."
  },
  {
    title: "Global Elevator Forum 2024",
    location: "Dubai, UAE",
    year: "2024",
    tag: "B2B Summit",
    image: "/images/exhibition/booth_3.png",
    description: "Participated in B2B technical symposiums discussing safety regulations and modern accessibility features for supertall high-rise elevator control systems."
  },
  {
    title: "Engineering Technology Expo 2023",
    location: "New Delhi, India",
    year: "2023",
    tag: "National Expo",
    image: "/images/exhibition/booth_4.png",
    description: "Presented our touch-sensitive capacitive interface buttons and customized glass panels. Awarded the Innovation in Interface Design accolade."
  }
];

const upcomingEvents = [
  {
    event: "Interlift 2026",
    location: "Nuremberg, Germany",
    date: "October 13 - 16, 2026",
    status: "Booth Confirmed"
  },
  {
    event: "Lift City Expo 2026",
    location: "Riyadh, Saudi Arabia",
    date: "December 05 - 08, 2026",
    status: "Registration Open"
  }
];
---

<Layout 
  title="Exhibitions | Navkar Engineers - Global Elevator Trade Shows" 
  description="Explore Navkar Engineers' active participation at premier international elevator trade fairs, B2B conferences, and product design expos worldwide."
>
  <!-- Global Sticky Header -->
  <Navbar />

  <main class="bg-brand-dark min-h-screen">
    
    <!-- Hero Banner Section -->
    <section class="relative py-20 bg-brand-charcoal border-b border-white/5 bg-grid-pattern overflow-hidden">
      <!-- Glow effect -->
      <div class="absolute top-1/2 left-1/2 w-[600px] h-[300px] -translate-x-1/2 -translate-y-1/2 bg-brand-gold/5 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative text-center space-y-4">
        <!-- Breadcrumbs -->
        <div class="flex items-center justify-center gap-2 text-[10px] text-brand-light/40 uppercase tracking-widest font-semibold">
          <a href="/" class="hover:text-brand-gold transition-colors">Home</a>
          <span>&gt;&gt;</span>
          <span class="text-brand-gold">Exhibitions</span>
        </div>
        
        <h1 class="text-4xl sm:text-5xl font-display font-extrabold text-white tracking-tight leading-tight uppercase">
          Our <span class="text-gold-metallic">Exhibitions</span>
        </h1>
        <p class="text-sm sm:text-base text-brand-light/70 max-w-xl mx-auto font-light leading-relaxed">
          Showcasing high-end interface engineering and compliance-certified elevator fixtures at premier global industry trade fairs.
        </p>
        <div class="h-1 w-16 bg-brand-gold mx-auto mt-4"></div>
      </div>
    </section>

    <!-- Visual Gallery Grid -->
    <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        {exhibitions.map((expo) => (
          <div class="group flex flex-col bg-brand-charcoal border border-white/5 overflow-hidden transition-all duration-500 hover:border-brand-gold/40 hover:shadow-[0_15px_30px_rgba(0,0,0,0.6)]">
            
            <!-- Exhibition Image -->
            <div class="relative aspect-[16/10] w-full overflow-hidden bg-brand-dark">
              <div class="absolute inset-0 bg-brand-dark/20 z-10 group-hover:bg-transparent transition-colors duration-500"></div>
              <img 
                src={expo.image} 
                alt={expo.title} 
                class="w-full h-full object-cover grayscale contrast-110 group-hover:grayscale-0 group-hover:scale-[1.03] group-hover:contrast-100 transition-all duration-750 ease-out"
                loading="lazy"
              />
              
              <!-- Expo Tag & Year -->
              <div class="absolute top-4 left-4 z-20 flex gap-2">
                <span class="bg-brand-dark/95 border border-brand-gold/30 px-3 py-1 font-display text-[9px] font-bold tracking-widest text-brand-gold uppercase">
                  {expo.tag}
                </span>
                <span class="bg-brand-gold text-brand-dark px-3 py-1 font-display text-[9px] font-extrabold tracking-widest uppercase">
                  {expo.year}
                </span>
              </div>
            </div>

            <!-- Content -->
            <div class="p-8 flex-1 flex flex-col justify-between space-y-6">
              <div class="space-y-3">
                <h3 class="font-display font-bold text-xl text-white tracking-wide group-hover:text-brand-gold transition-colors duration-300">
                  {expo.title}
                </h3>
                <div class="flex items-center gap-2 text-[10px] text-brand-light/50 uppercase tracking-widest font-semibold">
                  <!-- Location Icon -->
                  <svg class="w-3.5 h-3.5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  <span>{expo.location}</span>
                </div>
                <p class="text-xs text-brand-light/70 font-light leading-relaxed pt-2">
                  {expo.description}
                </p>
              </div>
              
              <div class="h-[1px] w-full bg-white/5 pt-2"></div>
            </div>

          </div>
        ))}
      </div>

    </section>

    <!-- Chevron Transition Divider -->
    <div class="chevron-divider"></div>

    <!-- Upcoming Events Banner -->
    <section class="py-24 bg-brand-charcoal overflow-hidden border-t border-white/5 relative">
      <div class="absolute top-1/2 right-10 w-[300px] h-[300px] bg-brand-gold/3 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          <div class="lg:col-span-5 space-y-4 text-left">
            <h2 class="font-display font-semibold text-xs text-brand-gold uppercase tracking-widest">Global Roadmap</h2>
            <p class="font-display font-extrabold text-3xl text-white tracking-tight leading-tight">
              Meet Us at Upcoming <span class="text-gold-metallic">Industry Events</span>
            </p>
            <p class="text-xs text-brand-light/65 leading-relaxed font-light max-w-sm">
              We routinely travel and present at trade expos. Connect directly with our lead design engineers to schedule a private B2B portfolio review.
            </p>
            <div class="pt-2">
              <a 
                href="/#contact" 
                class="btn-chevron-hover inline-flex items-center justify-center px-6 py-3.5 bg-transparent border border-brand-gold/45 text-brand-gold hover:text-brand-dark hover:bg-brand-gold font-display text-xs font-bold tracking-widest uppercase transition-all duration-300 focus:outline-none"
              >
                <span>Schedule Meeting</span>
                <span class="chevron-icon ml-2 text-sm font-bold">&gt;&gt;</span>
              </a>
            </div>
          </div>

          <div class="lg:col-span-7 space-y-6">
            {upcomingEvents.map((event) => (
              <div class="flex flex-col sm:flex-row sm:items-center justify-between p-6 border border-white/5 bg-brand-dark/40 relative">
                <!-- Golden edge indicator -->
                <div class="absolute left-0 top-0 h-full w-[2px] bg-brand-gold"></div>
                
                <div class="space-y-1.5 text-left">
                  <h4 class="font-display font-bold text-white text-base tracking-wide">{event.event}</h4>
                  <div class="flex items-center gap-4 text-[10px] text-brand-light/50 uppercase tracking-widest font-semibold">
                    <span class="flex items-center gap-1">
                      <svg class="w-3.5 h-3.5 text-brand-gold/80" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      </svg>
                      {event.location}
                    </span>
                    <span>•</span>
                    <span class="flex items-center gap-1">
                      <svg class="w-3.5 h-3.5 text-brand-gold/80" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                      </svg>
                      {event.date}
                    </span>
                  </div>
                </div>

                <div class="mt-4 sm:mt-0 self-start sm:self-auto">
                  <span class="inline-block px-3 py-1 text-[9px] font-bold text-brand-gold border border-brand-gold/30 bg-brand-gold/5 uppercase tracking-wider">
                    {event.status}
                  </span>
                </div>
              </div>
            ))}
          </div>

        </div>

      </div>
    </section>

  </main>

  <!-- Global Footer -->
  <Footer />
</Layout>
