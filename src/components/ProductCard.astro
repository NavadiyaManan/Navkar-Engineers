---
// ProductCard.astro
interface Spec {
  label: string;
  value: string;
}

interface Props {
  title: string;
  category: string;
  image: string;
  specifications: Spec[];
  datasheetPath?: string;
}

const { 
  title, 
  category, 
  image, 
  specifications, 
  datasheetPath = "#" 
} = Astro.props;
---

<div class="group flex flex-col bg-brand-charcoal border border-white/5 overflow-hidden transition-all duration-500 hover:border-brand-gold/40 hover:shadow-[0_15px_30px_rgba(0,0,0,0.5)]">
  
  <!-- Product Image Container -->
  <div class="relative aspect-[4/3] w-full overflow-hidden bg-brand-dark">
    <!-- Overlay filter -->
    <div class="absolute inset-0 bg-brand-dark/20 z-10 group-hover:bg-transparent transition-colors duration-500"></div>
    
    <!-- Image -->
    <img 
      src={image} 
      alt={title} 
      class="w-full h-full object-cover grayscale contrast-115 group-hover:grayscale-0 group-hover:scale-105 group-hover:contrast-100 transition-all duration-750 ease-out"
      loading="lazy"
    />
    
    <!-- Category Tag -->
    <div class="absolute top-4 left-4 z-20 bg-brand-dark/90 border border-brand-gold/30 px-3 py-1 font-display text-[10px] font-bold tracking-widest text-brand-gold uppercase">
      {category}
    </div>
  </div>

  <!-- Content Container -->
  <div class="flex-1 flex flex-col p-6 sm:p-8 space-y-6">
    
    <!-- Title -->
    <div>
      <h3 class="font-display font-bold text-xl text-white tracking-wide group-hover:text-brand-gold transition-colors duration-300">
        {title}
      </h3>
      <div class="h-[1px] w-12 bg-brand-gold/50 mt-3 group-hover:w-20 transition-all duration-500"></div>
    </div>

    <!-- Technical Specifications Table -->
    <div class="flex-1">
      <p class="font-display font-semibold text-[10px] text-brand-light/40 tracking-wider uppercase mb-3">Technical Specifications</p>
      <div class="border-t border-white/5 divide-y divide-white/5 text-xs">
        {specifications.map((spec) => (
          <div class="py-2.5 flex justify-between gap-4">
            <span class="text-brand-light/50 font-light">{spec.label}</span>
            <span class="text-white font-medium text-right">{spec.value}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Action Button (Download Datasheet) -->
    <div class="pt-4">
      <a 
        href={datasheetPath} 
        download
        class="w-full btn-chevron-hover inline-flex items-center justify-center py-3 bg-transparent border border-white/10 hover:border-brand-gold text-brand-light hover:text-brand-dark hover:bg-brand-gold font-display text-xs font-bold tracking-widest uppercase transition-all duration-300 focus:outline-none"
      >
        <span>Download Datasheet (PDF)</span>
        <span class="chevron-icon ml-2 text-sm font-bold">&gt;&gt;</span>
      </a>
    </div>

  </div>
</div>
