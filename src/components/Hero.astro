---
// Hero.astro
---
<section id="home" class="relative overflow-hidden pt-24 pb-20 md:pt-32 md:pb-28 lg:py-36 bg-grid-pattern">
  <!-- Glowing circular accents -->
  <div class="absolute top-1/4 right-0 w-[500px] h-[500px] bg-brand-gold/5 rounded-full blur-[120px] pointer-events-none -z-10"></div>
  <div class="absolute bottom-0 left-10 w-[400px] h-[400px] bg-brand-gold/3 rounded-full blur-[100px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Text Content (Left side) -->
      <div class="lg:col-span-7 flex flex-col justify-center text-left space-y-8 z-10">
        
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 self-start px-3 py-1.5 border border-brand-gold/30 bg-brand-gold/5 rounded-full backdrop-blur-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-gold animate-pulse"></span>
          <span class="text-brand-gold font-display text-xs font-bold tracking-widest uppercase">Global Standards Certified</span>
        </div>

        <!-- Heading -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-extrabold text-white tracking-tight leading-tight">
          Precision Engineering for <br/>
          <span class="text-gold-metallic">Global Vertical Mobility</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-brand-light/75 max-w-xl font-sans font-light leading-relaxed">
          Navkar Engineers designs and manufactures world-class elevator interfaces. From tactile high-end push buttons to premium Landing (L.O.P.) and Car Operating Panels (C.O.P.), we elevate user interaction through unmatched precision.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 sm:items-center">
          <a 
            href="#contact" 
            class="btn-chevron-hover w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-gold-metallic text-brand-dark font-display font-bold text-sm tracking-wider uppercase transition-transform hover:-translate-y-0.5 focus:outline-none"
          >
            <span>Request Specifications</span>
            <span class="chevron-icon ml-2 text-base font-bold">&gt;&gt;</span>
          </a>
          <a 
            href="#products" 
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-transparent border border-white/20 text-white hover:border-brand-gold hover:text-brand-gold font-display font-bold text-sm tracking-wider uppercase transition-all duration-300 focus:outline-none"
          >
            Explore Catalog
          </a>
        </div>

        <!-- Trust Mini-Pills -->
        <div class="pt-6 border-t border-white/5 grid grid-cols-3 gap-4">
          <div>
            <p class="text-2xl sm:text-3xl font-display font-extrabold text-brand-gold">100%</p>
            <p class="text-xs text-brand-light/60 uppercase tracking-wider mt-1">Custom Engineered</p>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-display font-extrabold text-brand-gold">EN 81</p>
            <p class="text-xs text-brand-light/60 uppercase tracking-wider mt-1">European Standard</p>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-display font-extrabold text-brand-gold">ISO</p>
            <p class="text-xs text-brand-light/60 uppercase tracking-wider mt-1">9001:2015 Quality</p>
          </div>
        </div>

      </div>

      <!-- Graphical Content (Right side) -->
      <div class="lg:col-span-5 relative flex justify-center items-center">
        <!-- Background geometric decorative cards -->
        <div class="absolute -top-6 -left-6 w-24 h-24 border-t-2 border-l-2 border-brand-gold/30 pointer-events-none"></div>
        <div class="absolute -bottom-6 -right-6 w-24 h-24 border-b-2 border-r-2 border-brand-gold/30 pointer-events-none"></div>
        
        <!-- Main Image Container -->
        <div class="relative w-full max-w-[420px] aspect-[4/5] overflow-hidden glass-panel-gold p-2 shadow-2xl transition-transform duration-500 hover:scale-[1.02]">
          <img 
            src="/images/hero_elevator_render.png" 
            alt="Navkar Engineers Premium Elevator Operating Panel" 
            class="w-full h-full object-cover grayscale contrast-125 brightness-90 hover:grayscale-0 hover:contrast-100 hover:brightness-100 transition-all duration-750 ease-out"
            loading="eager"
          />
          
          <!-- Abstract overlay details representing precision measuring -->
          <div class="absolute top-4 right-4 flex flex-col items-end font-mono text-[10px] text-brand-gold/80 tracking-widest bg-brand-charcoal/80 px-2.5 py-1.5 border border-brand-gold/30 select-none">
            <span>SYS: CALIBRATED</span>
            <span>TOL: &lt;0.02mm</span>
          </div>

          <!-- Bottom floating badge -->
          <div class="absolute bottom-6 left-6 right-6 bg-brand-charcoal/95 border border-brand-gold/30 p-4 backdrop-blur-md flex items-center justify-between">
            <div>
              <p class="font-display font-bold text-xs uppercase text-white tracking-wider">Car Operating Panel</p>
              <p class="font-sans font-light text-[10px] text-brand-gold uppercase tracking-widest mt-0.5">NCOP-Series Gold edition</p>
            </div>
            <div class="text-brand-gold font-display font-black text-sm tracking-tighter">
              &gt;&gt;
            </div>
          </div>
        </div>
        
      </div>
      
    </div>
  </div>
</section>
