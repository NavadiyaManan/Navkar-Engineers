---
// Navbar.astro
---
<header class="sticky top-0 z-50 w-full bg-brand-charcoal/90 backdrop-blur-md border-b border-white/5 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo Section -->
      <a href="/" class="flex items-center focus:outline-none" aria-label="Navkar Engineers Home">
        <img 
          src="/images/logo.png" 
          alt="Navkar Engineers Logo" 
          class="h-10 sm:h-12 w-auto object-contain transition-all duration-500 hover:scale-[1.03] hover:drop-shadow-[0_0_15px_rgba(197,160,67,0.45)] logo-animated" 
        />
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center space-x-5 lg:space-x-8" aria-label="Desktop Navigation">
        <a href="/" class="nav-link text-white font-display text-sm font-medium tracking-wide uppercase hover:text-brand-gold transition-colors duration-300 relative py-2">Home</a>
        <a href="/#about" class="nav-link text-brand-light/85 font-display text-sm font-medium tracking-wide uppercase hover:text-brand-gold transition-colors duration-300 relative py-2">About Us</a>
        <a href="/#products" class="nav-link text-brand-light/85 font-display text-sm font-medium tracking-wide uppercase hover:text-brand-gold transition-colors duration-300 relative py-2">Products</a>
        <a href="/exhibition" class="nav-link text-brand-light/85 font-display text-sm font-medium tracking-wide uppercase hover:text-brand-gold transition-colors duration-300 relative py-2">Exhibition</a>
        <a href="/client" class="nav-link text-brand-light/85 font-display text-sm font-medium tracking-wide uppercase hover:text-brand-gold transition-colors duration-300 relative py-2">Clients</a>
        <a href="/#certifications" class="nav-link text-brand-light/85 font-display text-sm font-medium tracking-wide uppercase hover:text-brand-gold transition-colors duration-300 relative py-2">Certifications</a>
        <a href="/#contact" class="nav-link text-brand-light/85 font-display text-sm font-medium tracking-wide uppercase hover:text-brand-gold transition-colors duration-300 relative py-2">Contact</a>
      </nav>

      <!-- CTA Button & Social Media Desktop -->
      <div class="hidden lg:flex items-center space-x-6">
        <!-- Social Media Icons -->
        <div class="flex items-center space-x-4">
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="text-brand-gold/75 hover:text-brand-gold-light transition-all duration-300 hover:scale-110" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="text-brand-gold/75 hover:text-brand-gold-light transition-all duration-300 hover:scale-110" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-brand-gold/75 hover:text-brand-gold-light transition-all duration-300 hover:scale-110" aria-label="Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
          <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="text-brand-gold/75 hover:text-brand-gold-light transition-all duration-300 hover:scale-110" aria-label="YouTube">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M23.498 6.163a3.003 3.003 0 00-2.11-2.11C19.517 3.545 12 3.545 12 3.545s-7.517 0-9.388.508a3.003 3.003 0 00-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 002.11 2.11c1.871.508 9.388.508 9.388.508s7.517 0 9.388-.508a3.002 3.002 0 002.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        </div>
        
        <!-- Divider -->
        <div class="h-6 w-[1px] bg-white/10"></div>

        <a 
          href="/#contact" 
          class="btn-chevron-hover relative inline-flex items-center justify-center px-5 py-2.5 bg-transparent border border-brand-gold/45 text-brand-gold hover:text-brand-dark hover:bg-brand-gold font-display text-xs font-semibold tracking-widest uppercase transition-all duration-300 focus:outline-none"
        >
          <span>Get In Touch</span>
          <span class="chevron-icon ml-1 text-sm font-bold">&gt;&gt;</span>
        </a>
      </div>

      <!-- Mobile Menu Button (Hamburger) -->
      <div class="flex md:hidden">
        <button 
          id="mobile-menu-toggle" 
          type="button" 
          class="inline-flex items-center justify-center p-2 rounded-md text-brand-light hover:text-brand-gold hover:bg-white/5 focus:outline-none transition-colors duration-300"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="sr-only">Open main menu</span>
          <svg class="h-6 w-6 block" id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="h-6 w-6 hidden" id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Navigation Menu -->
  <div 
    id="mobile-menu" 
    class="hidden md:hidden absolute top-20 left-0 w-full bg-brand-charcoal border-b border-white/5 shadow-2xl transition-all duration-300 ease-in-out z-40"
  >
    <div class="px-4 pt-2 pb-6 space-y-3 sm:px-6">
      <a href="/" class="mobile-nav-link block px-3 py-2.5 text-base font-semibold text-white uppercase tracking-wider hover:bg-white/5 hover:text-brand-gold transition-all rounded">Home</a>
      <a href="/#about" class="mobile-nav-link block px-3 py-2.5 text-base font-semibold text-brand-light/85 uppercase tracking-wider hover:bg-white/5 hover:text-brand-gold transition-all rounded">About Us</a>
      <a href="/#products" class="mobile-nav-link block px-3 py-2.5 text-base font-semibold text-brand-light/85 uppercase tracking-wider hover:bg-white/5 hover:text-brand-gold transition-all rounded">Products</a>
      <a href="/exhibition" class="mobile-nav-link block px-3 py-2.5 text-base font-semibold text-brand-light/85 uppercase tracking-wider hover:bg-white/5 hover:text-brand-gold transition-all rounded">Exhibition</a>
      <a href="/client" class="mobile-nav-link block px-3 py-2.5 text-base font-semibold text-brand-light/85 uppercase tracking-wider hover:bg-white/5 hover:text-brand-gold transition-all rounded">Clients</a>
      <a href="/#certifications" class="mobile-nav-link block px-3 py-2.5 text-base font-semibold text-brand-light/85 uppercase tracking-wider hover:bg-white/5 hover:text-brand-gold transition-all rounded">Certifications</a>
      <a href="/#contact" class="mobile-nav-link block px-3 py-2.5 text-base font-semibold text-brand-light/85 uppercase tracking-wider hover:bg-white/5 hover:text-brand-gold transition-all rounded">Contact</a>
      <div class="pt-4 px-3">
        <a 
          href="/#contact" 
          class="w-full inline-flex items-center justify-center py-3 bg-brand-gold text-brand-dark font-display text-sm font-bold tracking-wider uppercase transition-colors hover:bg-brand-gold-light focus:outline-none"
        >
          Request a Quote
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Custom line transition for active menu items on desktop */
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background-color: var(--color-brand-gold);
    transition: width 0.3s ease, left 0.3s ease;
  }
  .nav-link:hover::after {
    width: 100%;
    left: 0;
  }

  @keyframes logo-entrance {
    0% {
      opacity: 0;
      transform: translateX(-15px) scale(0.98);
    }
    100% {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }

  .logo-animated {
    animation: logo-entrance 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<script>
  // Navbar toggle script
  const setupNavbar = () => {
    const toggleButton = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const closeIcon = document.getElementById('menu-icon-close');
    const openIcon = document.getElementById('menu-icon-open');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    if (toggleButton && mobileMenu && closeIcon && openIcon) {
      const toggleMenu = () => {
        const isExpanded = toggleButton.getAttribute('aria-expanded') === 'true';
        toggleButton.setAttribute('aria-expanded', (!isExpanded).toString());
        
        mobileMenu.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
        openIcon.classList.toggle('hidden');
      };

      toggleButton.addEventListener('click', toggleMenu);

      // Close menu when a link is clicked
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          if (!mobileMenu.classList.contains('hidden')) {
            toggleMenu();
          }
        });
      });
    }

    // Scroll styling: add border/background shadow on scroll
    const header = document.querySelector('header');
    window.addEventListener('scroll', () => {
      if (header) {
        if (window.scrollY > 20) {
          header.classList.add('shadow-xl', 'bg-brand-dark/95');
          header.classList.remove('bg-brand-charcoal/90');
        } else {
          header.classList.remove('shadow-xl', 'bg-brand-dark/95');
          header.classList.add('bg-brand-charcoal/90');
        }
      }
    });
  };

  // Run on page load and astro page loads (if using transitions)
  setupNavbar();
  document.addEventListener('astro:after-swap', setupNavbar);
</script>
