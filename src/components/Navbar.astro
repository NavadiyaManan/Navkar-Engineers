---
// Navbar.astro
---
<header class="sticky top-0 z-50 w-full bg-brand-dark/80 backdrop-blur-xl border-b border-white/5 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-22">
      
      <!-- Logo Section -->
      <a href="/" class="flex items-center focus:outline-none" aria-label="Navkar Engineers Home">
        <img 
          src="/images/logo.png" 
          alt="Navkar Engineers Logo" 
          class="h-10 sm:h-12 w-auto object-contain transition-all duration-500 hover:scale-[1.02] hover:drop-shadow-[0_0_15px_rgba(197,160,67,0.4)] logo-animated" 
        />
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden lg:flex items-center gap-x-5 xl:gap-x-7" aria-label="Desktop Navigation">
        <a href="/" class="nav-link text-white/90 font-display text-[13px] font-semibold tracking-widest uppercase hover:text-brand-gold transition-colors duration-300 relative py-2.5 whitespace-nowrap">Home</a>
        <a href="/#about" class="nav-link text-brand-light/75 font-display text-[13px] font-semibold tracking-widest uppercase hover:text-brand-gold transition-colors duration-300 relative py-2.5 whitespace-nowrap">About Us</a>
        
        <!-- Products Dropdown Menu -->
        <div class="relative group py-2.5">
          <button class="flex items-center gap-1 text-brand-light/75 font-display text-[13px] font-semibold tracking-widest uppercase hover:text-brand-gold transition-colors duration-300 focus:outline-none whitespace-nowrap">
            <span>Products</span>
            <svg class="w-3.5 h-3.5 group-hover:rotate-180 transition-transform duration-300 text-brand-gold/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          
          <!-- Dropdown Options Panel -->
          <div class="absolute top-full left-1/2 -translate-x-1/2 hidden group-hover:block w-48 bg-brand-charcoal/95 backdrop-blur-md border border-white/10 shadow-2xl py-2 mt-1.5 z-50 rounded-sm">
            <!-- Diamond shape arrow pointer -->
            <div class="absolute -top-1.5 left-1/2 -translate-x-1/2 w-3 h-3 bg-brand-charcoal border-t border-l border-white/10 rotate-45"></div>
            <a href="/#products" class="block px-4 py-2.5 text-xs font-semibold text-brand-light/80 hover:bg-white/5 hover:text-brand-gold uppercase tracking-wider transition-all">COP & LOP</a>
            <a href="/#products" class="block px-4 py-2.5 text-xs font-semibold text-brand-light/80 hover:bg-white/5 hover:text-brand-gold uppercase tracking-wider transition-all">Buttons</a>
            <a href="/other-products" class="block px-4 py-2.5 text-xs font-semibold text-brand-light/80 hover:bg-white/5 hover:text-brand-gold uppercase tracking-wider transition-all">Other Products</a>
          </div>
        </div>

        <a href="/exhibition" class="nav-link text-brand-light/75 font-display text-[13px] font-semibold tracking-widest uppercase hover:text-brand-gold transition-colors duration-300 relative py-2.5 whitespace-nowrap">Exhibition</a>
        <a href="/client" class="nav-link text-brand-light/75 font-display text-[13px] font-semibold tracking-widest uppercase hover:text-brand-gold transition-colors duration-300 relative py-2.5 whitespace-nowrap">Clients</a>
        <a href="/#certifications" class="nav-link text-brand-light/75 font-display text-[13px] font-semibold tracking-widest uppercase hover:text-brand-gold transition-colors duration-300 relative py-2.5 whitespace-nowrap">Certifications</a>
        <a href="/#contact" class="nav-link text-brand-light/75 font-display text-[13px] font-semibold tracking-widest uppercase hover:text-brand-gold transition-colors duration-300 relative py-2.5 whitespace-nowrap">Contact</a>
      </nav>

      <!-- Right Side CTA Action -->
      <div class="hidden lg:flex items-center">
        <a 
          href="/#contact" 
          class="btn-chevron-hover relative inline-flex items-center justify-center px-5.5 py-2.5 bg-transparent border border-brand-gold/45 text-brand-gold hover:text-brand-dark hover:bg-brand-gold font-display text-[11px] font-bold tracking-widest uppercase transition-all duration-300 focus:outline-none whitespace-nowrap"
        >
          <span>Get In Touch</span>
          <span class="chevron-icon ml-1.5 text-xs font-bold">&gt;&gt;</span>
        </a>
      </div>

      <!-- Mobile Menu Button (Hamburger) -->
      <div class="flex lg:hidden">
        <button 
          id="mobile-menu-toggle" 
          type="button" 
          class="inline-flex items-center justify-center p-2 rounded-md text-brand-light hover:text-brand-gold hover:bg-white/5 focus:outline-none transition-colors duration-300"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="sr-only">Open main menu</span>
          <svg class="h-6 w-6 block" id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="h-6 w-6 hidden" id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Navigation Menu -->
  <div 
    id="mobile-menu" 
    class="hidden lg:hidden absolute top-22 left-0 w-full bg-brand-charcoal border-b border-white/5 shadow-2xl transition-all duration-300 ease-in-out z-40"
  >
    <div class="px-4 pt-2 pb-6 space-y-3 sm:px-6">
      <a href="/" class="mobile-nav-link block px-3 py-2.5 text-base font-semibold text-white uppercase tracking-wider hover:bg-white/5 hover:text-brand-gold transition-all rounded">Home</a>
      <a href="/#about" class="mobile-nav-link block px-3 py-2.5 text-base font-semibold text-brand-light/85 uppercase tracking-wider hover:bg-white/5 hover:text-brand-gold transition-all rounded">About Us</a>
      <!-- Mobile Products Menu with submenu links -->
      <div class="px-3 py-1 space-y-2 border-l border-white/5">
        <span class="block text-xs font-semibold text-brand-gold uppercase tracking-widest pb-0.5">Products</span>
        <div class="pl-3 space-y-1.5 border-l border-brand-gold/20">
          <a href="/#products" class="mobile-nav-link block text-sm font-medium text-brand-light/85 hover:text-brand-gold uppercase tracking-wide">COP & LOP</a>
          <a href="/#products" class="mobile-nav-link block text-sm font-medium text-brand-light/85 hover:text-brand-gold uppercase tracking-wide">Buttons</a>
          <a href="/other-products" class="mobile-nav-link block text-sm font-medium text-brand-light/85 hover:text-brand-gold uppercase tracking-wide">Other Products</a>
        </div>
      </div>
      <a href="/exhibition" class="mobile-nav-link block px-3 py-2.5 text-base font-semibold text-brand-light/85 uppercase tracking-wider hover:bg-white/5 hover:text-brand-gold transition-all rounded">Exhibition</a>
      <a href="/client" class="mobile-nav-link block px-3 py-2.5 text-base font-semibold text-brand-light/85 uppercase tracking-wider hover:bg-white/5 hover:text-brand-gold transition-all rounded">Clients</a>
      <a href="/#certifications" class="mobile-nav-link block px-3 py-2.5 text-base font-semibold text-brand-light/85 uppercase tracking-wider hover:bg-white/5 hover:text-brand-gold transition-all rounded">Certifications</a>
      <a href="/#contact" class="mobile-nav-link block px-3 py-2.5 text-base font-semibold text-brand-light/85 uppercase tracking-wider hover:bg-white/5 hover:text-brand-gold transition-all rounded">Contact</a>
      <div class="pt-4 px-3">
        <a 
          href="/#contact" 
          class="w-full inline-flex items-center justify-center py-3 bg-brand-gold text-brand-dark font-display text-sm font-bold tracking-wider uppercase transition-colors hover:bg-brand-gold-light focus:outline-none"
        >
          Request a Quote
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Custom line transition for active menu items on desktop */
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background-color: var(--color-brand-gold);
    transition: width 0.3s ease, left 0.3s ease;
  }
  .nav-link:hover::after {
    width: 100%;
    left: 0;
  }

  @keyframes logo-entrance {
    0% {
      opacity: 0;
      transform: translateX(-15px) scale(0.98);
    }
    100% {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }

  .logo-animated {
    animation: logo-entrance 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<script>
  // Navbar toggle script
  const setupNavbar = () => {
    const toggleButton = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const closeIcon = document.getElementById('menu-icon-close');
    const openIcon = document.getElementById('menu-icon-open');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    if (toggleButton && mobileMenu && closeIcon && openIcon) {
      const toggleMenu = () => {
        const isExpanded = toggleButton.getAttribute('aria-expanded') === 'true';
        toggleButton.setAttribute('aria-expanded', (!isExpanded).toString());
        
        mobileMenu.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
        openIcon.classList.toggle('hidden');
      };

      toggleButton.addEventListener('click', toggleMenu);

      // Close menu when a link is clicked
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          if (!mobileMenu.classList.contains('hidden')) {
            toggleMenu();
          }
        });
      });
    }

    // Scroll styling: add border/background shadow on scroll
    const header = document.querySelector('header');
    window.addEventListener('scroll', () => {
      if (header) {
        if (window.scrollY > 20) {
          header.classList.add('shadow-xl', 'bg-brand-dark/95');
          header.classList.remove('bg-brand-dark/80');
        } else {
          header.classList.remove('shadow-xl', 'bg-brand-dark/95');
          header.classList.add('bg-brand-dark/80');
        }
      }
    });
  };

  // Run on page load and astro page loads (if using transitions)
  setupNavbar();
  document.addEventListener('astro:after-swap', setupNavbar);
</script>
