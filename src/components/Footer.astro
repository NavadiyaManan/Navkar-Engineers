---
// Footer.astro
---
<footer id="contact" class="relative bg-brand-dark overflow-hidden border-t border-white/5 pt-20 pb-10">
  <div class="absolute bottom-0 left-0 w-full h-[3px] bg-gradient-to-r from-transparent via-brand-gold to-transparent"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Part: Contact / RFQ Form -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 pb-16 border-b border-white/5 items-start">
      
      <!-- RFQ / Contact Form Content -->
      <div class="lg:col-span-5 space-y-6">
        <h3 class="font-display font-extrabold text-2xl text-white tracking-tight uppercase">
          Partner With <br/>
          <span class="text-gold-metallic">Navkar Engineers</span>
        </h3>
        <p class="text-sm text-brand-light/70 font-light leading-relaxed">
          Submit your product requirements or request technical drawings. Our international sales and engineering team typically responds within 1 business day.
        </p>
        
        <div class="space-y-4">
          <div class="flex items-center gap-4 text-sm">
            <div class="p-2.5 bg-brand-charcoal text-brand-gold border border-white/5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="text-[10px] text-brand-light/40 uppercase tracking-widest font-semibold">Global Inquiry Email</p>
              <a href="mailto:export@navkarengineers.com" class="text-white hover:text-brand-gold transition-colors font-medium">export@navkarengineers.com</a>
            </div>
          </div>

          <div class="flex items-center gap-4 text-sm">
            <div class="p-2.5 bg-brand-charcoal text-brand-gold border border-white/5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <p class="text-[10px] text-brand-light/40 uppercase tracking-widest font-semibold">Technical Hotline</p>
              <a href="tel:+919876543210" class="text-white hover:text-brand-gold transition-colors font-medium">+91 98765 43210</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Form Inputs -->
      <div class="lg:col-span-7 bg-brand-charcoal p-8 border border-white/5 relative">
        <div class="absolute -top-[1px] right-8 w-12 h-[2px] bg-brand-gold"></div>
        <form class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-[10px] text-brand-light/40 uppercase tracking-wider font-semibold mb-2">Your Name</label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                required
                class="w-full bg-brand-dark/95 border border-white/10 px-4 py-3 text-sm text-white focus:outline-none focus:border-brand-gold transition-colors"
                placeholder="John Doe"
              />
            </div>
            <div>
              <label for="email" class="block text-[10px] text-brand-light/40 uppercase tracking-wider font-semibold mb-2">Business Email</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required
                class="w-full bg-brand-dark/95 border border-white/10 px-4 py-3 text-sm text-white focus:outline-none focus:border-brand-gold transition-colors"
                placeholder="j.doe@company.com"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="company" class="block text-[10px] text-brand-light/40 uppercase tracking-wider font-semibold mb-2">Company Name</label>
              <input 
                type="text" 
                id="company" 
                name="company" 
                class="w-full bg-brand-dark/95 border border-white/10 px-4 py-3 text-sm text-white focus:outline-none focus:border-brand-gold transition-colors"
                placeholder="Global Elevators Corp"
              />
            </div>
            <div>
              <label for="product-category" class="block text-[10px] text-brand-light/40 uppercase tracking-wider font-semibold mb-2">Required Component</label>
              <select 
                id="product-category" 
                name="product-category" 
                class="w-full bg-brand-dark/95 border border-white/10 px-4 py-3 text-sm text-brand-light/60 focus:outline-none focus:border-brand-gold transition-colors"
              >
                <option value="push-buttons">Elevator Push Buttons</option>
                <option value="lop">Landing Operating Panels (L.O.P.)</option>
                <option value="cop">Car Operating Panels (C.O.P.)</option>
                <option value="custom">Bespoke Custom Engineering</option>
              </select>
            </div>
          </div>

          <div>
            <label for="message" class="block text-[10px] text-brand-light/40 uppercase tracking-wider font-semibold mb-2">Technical Requirements / Scope</label>
            <textarea 
              id="message" 
              name="message" 
              rows="4" 
              required
              class="w-full bg-brand-dark/95 border border-white/10 px-4 py-3 text-sm text-white focus:outline-none focus:border-brand-gold transition-colors resize-none"
              placeholder="Please describe dimensions, materials (e.g. brushed steel, PVD gold), compliance norms, or quantities needed..."
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="w-full btn-chevron-hover inline-flex items-center justify-center py-4 bg-gold-metallic text-brand-dark font-display font-bold text-xs tracking-widest uppercase transition-transform hover:-translate-y-0.5 focus:outline-none"
          >
            <span>Submit Technical Request</span>
            <span class="chevron-icon ml-2 text-sm font-bold">&gt;&gt;</span>
          </button>
        </form>
      </div>

    </div>

    <!-- Middle Part: Structured Footer Links -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 py-16 border-b border-white/5">
      
      <!-- Company Info column -->
      <div class="lg:col-span-5 space-y-6">
        <a href="/" class="flex items-center focus:outline-none" aria-label="Navkar Engineers Home">
          <img 
            src="/images/logo.png" 
            alt="Navkar Engineers Logo" 
            class="h-10 w-auto object-contain transition-transform duration-300 hover:scale-105" 
          />
        </a>
        <p class="text-xs text-brand-light/60 font-light leading-relaxed max-w-sm">
          Navkar Engineers is a premier manufacturer of custom-designed, heavy-duty tactile human-machine interfaces for modern elevator applications. Our focus lies in ultra-fine finishings, certified safety standards, and reliable global distribution.
        </p>
      </div>

      <!-- Navigation links column -->
      <div class="lg:col-span-3 space-y-4">
        <h4 class="font-display font-semibold text-xs text-white uppercase tracking-widest">Sitemap</h4>
        <ul class="space-y-2.5 text-xs text-brand-light/60">
          <li><a href="#home" class="hover:text-brand-gold transition-colors font-light">Home</a></li>
          <li><a href="#about" class="hover:text-brand-gold transition-colors font-light">About Us & Capabilities</a></li>
          <li><a href="#products" class="hover:text-brand-gold transition-colors font-light">Product Portfolio</a></li>
          <li><a href="#certifications" class="hover:text-brand-gold transition-colors font-light">Certifications & Standards</a></li>
        </ul>
      </div>

      <!-- Products links column -->
      <div class="lg:col-span-4 space-y-4">
        <h4 class="font-display font-semibold text-xs text-white uppercase tracking-widest">Products</h4>
        <ul class="space-y-2.5 text-xs text-brand-light/60">
          <li><a href="#products" class="hover:text-brand-gold transition-colors font-light">Elevator Push Buttons (NPB-series)</a></li>
          <li><a href="#products" class="hover:text-brand-gold transition-colors font-light">Landing Operating Panels (NLOP-series)</a></li>
          <li><a href="#products" class="hover:text-brand-gold transition-colors font-light">Car Operating Panels (NCOP-series)</a></li>
          <li><a href="#products" class="hover:text-brand-gold transition-colors font-light">Bespoke Architectural Fixtures</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Part: Copyright & Legal -->
    <div class="flex flex-col sm:flex-row items-center justify-between pt-10 text-[10px] text-brand-light/40 uppercase tracking-widest gap-4">
      <p>© {new Date().getFullYear()} Navkar Engineers. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="#" class="hover:text-brand-gold transition-colors font-light">Privacy Policy</a>
        <span>|</span>
        <a href="#" class="hover:text-brand-gold transition-colors font-light">Terms of Service</a>
      </div>
    </div>

  </div>
</footer>
