---
// Footer.astro
---
<footer class="relative bg-brand-dark overflow-hidden border-t border-white/5 pt-16 pb-10">
  <div class="absolute bottom-0 left-0 w-full h-[3px] bg-gradient-to-r from-transparent via-brand-gold to-transparent"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Structured Footer Links -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 pb-16 border-b border-white/5">
      
      <!-- Company Info column -->
      <div class="lg:col-span-5 space-y-6 flex flex-col justify-between">
        <a href="/" class="flex items-center focus:outline-none" aria-label="Navkar Engineers Home">
          <img 
            src="/images/logo.png" 
            alt="Navkar Engineers Logo" 
            class="h-10 w-auto object-contain transition-all duration-500 hover:scale-[1.03] hover:drop-shadow-[0_0_15px_rgba(197,160,67,0.45)]" 
          />
        </a>
        <p class="text-xs text-brand-light/60 font-light leading-relaxed max-w-sm">
          Navkar Engineers is a premier manufacturer of custom-designed, heavy-duty tactile human-machine interfaces for modern elevator applications. Our focus lies in ultra-fine finishings, certified safety standards, and reliable global distribution.
        </p>
        
        <!-- Follow Us Wrapper -->
        <div class="space-y-3 pt-2">
          <p class="font-display font-semibold text-[10px] text-white uppercase tracking-widest">Follow Us</p>
          <div class="flex items-center space-x-4">
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="text-brand-gold/75 hover:text-brand-gold-light transition-all duration-300 hover:scale-110" aria-label="LinkedIn">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>
            <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="text-brand-gold/75 hover:text-brand-gold-light transition-all duration-300 hover:scale-110" aria-label="Facebook">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-brand-gold/75 hover:text-brand-gold-light transition-all duration-300 hover:scale-110" aria-label="Instagram">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
              </svg>
            </a>
            <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="text-brand-gold/75 hover:text-brand-gold-light transition-all duration-300 hover:scale-110" aria-label="YouTube">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M23.498 6.163a3.003 3.003 0 00-2.11-2.11C19.517 3.545 12 3.545 12 3.545s-7.517 0-9.388.508a3.003 3.003 0 00-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 002.11 2.11c1.871.508 9.388.508 9.388.508s7.517 0 9.388-.508a3.002 3.002 0 002.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Navigation links column -->
      <div class="lg:col-span-3 space-y-4">
        <h4 class="font-display font-semibold text-xs text-white uppercase tracking-widest">Sitemap</h4>
        <ul class="space-y-2.5 text-xs text-brand-light/60">
          <li><a href="/" class="hover:text-brand-gold transition-colors font-light">Home</a></li>
          <li><a href="/#about" class="hover:text-brand-gold transition-colors font-light">About Us & Capabilities</a></li>
          <li><a href="/#products" class="hover:text-brand-gold transition-colors font-light">Product Portfolio</a></li>
          <li><a href="/exhibition" class="hover:text-brand-gold transition-colors font-light">Exhibitions</a></li>
          <li><a href="/client" class="hover:text-brand-gold transition-colors font-light">Clients</a></li>
          <li><a href="/#certifications" class="hover:text-brand-gold transition-colors font-light">Certifications & Standards</a></li>
        </ul>
      </div>

      <!-- Products links column -->
      <div class="lg:col-span-4 space-y-4">
        <h4 class="font-display font-semibold text-xs text-white uppercase tracking-widest">Products</h4>
        <ul class="space-y-2.5 text-xs text-brand-light/60">
          <li><a href="/#products" class="hover:text-brand-gold transition-colors font-light">Elevator Push Buttons (NPB-series)</a></li>
          <li><a href="/#products" class="hover:text-brand-gold transition-colors font-light">Landing Operating Panels (NLOP-series)</a></li>
          <li><a href="/#products" class="hover:text-brand-gold transition-colors font-light">Car Operating Panels (NCOP-series)</a></li>
          <li><a href="/#products" class="hover:text-brand-gold transition-colors font-light">Bespoke Architectural Fixtures</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Part: Copyright & Legal -->
    <div class="flex flex-col sm:flex-row items-center justify-between pt-10 text-[10px] text-brand-light/40 uppercase tracking-widest gap-4">
      <p>© {new Date().getFullYear()} Navkar Engineers. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="#" class="hover:text-brand-gold transition-colors font-light">Privacy Policy</a>
        <span>|</span>
        <a href="#" class="hover:text-brand-gold transition-colors font-light">Terms of Service</a>
      </div>
    </div>

  </div>
</footer>
