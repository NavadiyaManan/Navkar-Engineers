---
// ProductShowcase.astro
import ProductCard from './ProductCard.astro';

const products = [
  {
    title: "NPB-200 Tactile Series",
    category: "Elevator Push Buttons",
    image: "/images/product_button_render.png",
    specifications: [
      { label: "Actuation Type", value: "Tactile Micro-Switch" },
      { label: "Material Finish", value: "SUS304 Brushed / Brass PVD" },
      { label: "Tactile Force", value: "1.5 N (Premium Feedback)" },
      { label: "LED Color Options", value: "Warm Gold / Ice White" },
      { label: "Operational Life", value: "> 5 Million Operations" },
      { label: "Ingress Protection", value: "IP54 / Vandal-Resistant EN81-71" }
    ],
    datasheetPath: "/datasheets/NPB_200_Tactile_Datasheet.pdf"
  },
  {
    title: "NLOP-350 Flush Mount",
    category: "Landing Operating Panels (L.O.P.)",
    image: "/images/hero_elevator_render.png",
    specifications: [
      { label: "System Layout", value: "Duplex/Simplex Landing Panel" },
      { label: "Mounting Style", value: "Ultra-Flush (2mm bezel depth)" },
      { label: "Display Core", value: "Ultra-Contrast TFT / Gold Dot Matrix" },
      { label: "Connectivity", value: "CANbus / RS485 Serial protocol" },
      { label: "Compliance standard", value: "EN 81-70 (Accessibility-Ready)" },
      { label: "Dimensions", value: "350mm (H) x 90mm (W)" }
    ],
    datasheetPath: "/datasheets/NLOP_350_Flush_Datasheet.pdf"
  },
  {
    title: "NCOP-800 Elite Column",
    category: "Car Operating Panels (C.O.P.)",
    image: "/images/product_cop_render.png",
    specifications: [
      { label: "Structural Form", value: "Full-Height Column Panel" },
      { label: "Finishing Metal", value: "Matte Charcoal / Titanium Gold PVD" },
      { label: "Panel Height", value: "2000mm standard (Bespoke Cut)" },
      { label: "Communication", value: "ADA intercom / hands-free phone" },
      { label: "Key Switch Options", value: "Fireman recall / Attendant lock" },
      { label: "Display System", value: "10-inch Full Color TFT Multimedia" }
    ],
    datasheetPath: "/datasheets/NCOP_800_Elite_Datasheet.pdf"
  }
];
---

<section id="products" class="relative py-24 bg-brand-dark overflow-hidden bg-grid-pattern">
  <div class="absolute top-1/3 left-0 w-[500px] h-[500px] bg-brand-gold/3 rounded-full blur-[120px] pointer-events-none -z-10"></div>
  <div class="absolute bottom-1/3 right-0 w-[500px] h-[500px] bg-brand-gold/3 rounded-full blur-[120px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="max-w-2xl text-left space-y-4">
        <h2 class="font-display font-semibold text-xs text-brand-gold uppercase tracking-widest">Product Portfolio</h2>
        <p class="font-display font-extrabold text-3xl sm:text-4xl text-white tracking-tight leading-tight">
          Precision Engineering Components for Global Infrastructure
        </p>
        <div class="h-1 w-16 bg-brand-gold mt-4"></div>
      </div>
      
      <div>
        <p class="text-sm text-brand-light/60 font-light max-w-sm">
          Explore our certified catalogs of high-performance elevator interfaces. Built with ultra-thin steel sheets and tactile micro-elements.
        </p>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {products.map((product) => (
        <ProductCard
          title={product.title}
          category={product.category}
          image={product.image}
          specifications={product.specifications}
          datasheetPath={product.datasheetPath}
        />
      ))}
    </div>

    <!-- Bottom CTA Info -->
    <div class="mt-16 text-center border border-white/5 bg-brand-charcoal/30 p-8 max-w-4xl mx-auto backdrop-blur-md">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="text-left">
          <h4 class="font-display font-bold text-white text-lg">Require custom panel configurations?</h4>
          <p class="text-sm text-brand-light/65 mt-1 font-light">We specialize in engineering unique sizes, engravings, and materials to match your architectural requirements.</p>
        </div>
        <a 
          href="#contact" 
          class="btn-chevron-hover flex-shrink-0 inline-flex items-center justify-center px-6 py-3.5 bg-gold-metallic text-brand-dark font-display font-bold text-xs tracking-widest uppercase transition-transform hover:-translate-y-0.5 focus:outline-none"
        >
          <span>Request Bespoke Consultation</span>
          <span class="chevron-icon ml-2 text-sm font-bold">&gt;&gt;</span>
        </a>
      </div>
    </div>

  </div>
</section>
