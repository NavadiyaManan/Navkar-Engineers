---
// Certifications.astro
---
<section id="certifications" class="relative py-16 bg-brand-charcoal overflow-hidden border-t border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center mb-12 space-y-2">
      <h2 class="font-display font-semibold text-xs text-brand-gold uppercase tracking-widest">Global Compliance</h2>
      <p class="font-display font-bold text-2xl text-white uppercase tracking-wider">Certifications & Standards</p>
      <div class="h-[1px] w-12 bg-brand-gold/60 mx-auto mt-3"></div>
    </div>

    <!-- Certification Badges Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-5xl mx-auto items-center">
      
      <!-- Certification 1: ISO 9001 -->
      <div class="group relative flex flex-col items-center justify-center p-6 border border-white/5 bg-brand-dark/40 hover:border-brand-gold/50 hover:bg-brand-dark/90 transition-all duration-300">
        <div class="text-brand-light/40 group-hover:text-brand-gold transition-colors duration-300 mb-4">
          <!-- ISO Graphic Logo using SVG -->
          <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <rect x="2" y="5" width="20" height="14" rx="2" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M7 9v6M17 9v6M12 9v6M10 12h4" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>
        <p class="font-display font-bold text-sm text-white tracking-wider">ISO 9001:2015</p>
        <p class="text-[10px] text-brand-light/50 uppercase tracking-widest mt-1 text-center font-light">Quality Management</p>
      </div>

      <!-- Certification 2: CE Certification -->
      <div class="group relative flex flex-col items-center justify-center p-6 border border-white/5 bg-brand-dark/40 hover:border-brand-gold/50 hover:bg-brand-dark/90 transition-all duration-300">
        <div class="text-brand-light/40 group-hover:text-brand-gold transition-colors duration-300 mb-4">
          <!-- CE Graphic Logo using SVG -->
          <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="9" stroke-width="1.5"/>
            <path d="M14 9a3 3 0 00-3 3 3 3 0 003 3" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M16 10.5h-1M16 13.5h-1" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>
        <p class="font-display font-bold text-sm text-white tracking-wider">CE MARK</p>
        <p class="text-[10px] text-brand-light/50 uppercase tracking-widest mt-1 text-center font-light">European Conformity</p>
      </div>

      <!-- Certification 3: EN 81-70 -->
      <div class="group relative flex flex-col items-center justify-center p-6 border border-white/5 bg-brand-dark/40 hover:border-brand-gold/50 hover:bg-brand-dark/90 transition-all duration-300">
        <div class="text-brand-light/40 group-hover:text-brand-gold transition-colors duration-300 mb-4">
          <!-- EN Graphic Logo using SVG -->
          <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2v20M2 12h20" stroke-width="1.5" stroke-linecap="round"/>
            <circle cx="12" cy="12" r="5" stroke-width="1.5"/>
          </svg>
        </div>
        <p class="font-display font-bold text-sm text-white tracking-wider">EN 81-70 / EN 81-20</p>
        <p class="text-[10px] text-brand-light/50 uppercase tracking-widest mt-1 text-center font-light">Safety & Accessibility</p>
      </div>

      <!-- Certification 4: RoHS -->
      <div class="group relative flex flex-col items-center justify-center p-6 border border-white/5 bg-brand-dark/40 hover:border-brand-gold/50 hover:bg-brand-dark/90 transition-all duration-300">
        <div class="text-brand-light/40 group-hover:text-brand-gold transition-colors duration-300 mb-4">
          <!-- RoHS Graphic Logo using SVG -->
          <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 12l2 2 4-4M3 12a9 9 0 1118 0 9 9 0 01-18 0z" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>
        <p class="font-display font-bold text-sm text-white tracking-wider">RoHS COMPLIANT</p>
        <p class="text-[10px] text-brand-light/50 uppercase tracking-widest mt-1 text-center font-light">Hazardous Substances Free</p>
      </div>

    </div>

    <!-- Subtext -->
    <div class="mt-8 text-center">
      <p class="text-xs text-brand-light/40 font-light max-w-xl mx-auto">
        All manufacturing processes and raw materials are audited annually to maintain compliance with global standards. Extended compliance records are available upon request.
      </p>
    </div>

    <!-- Section Divider -->
    <div class="h-[1px] w-full bg-white/5 my-16"></div>

    <!-- 5. Quality Certificates Showcase Gallery -->
    <div class="space-y-12">
      <div class="text-center space-y-2">
        <h3 class="font-display font-semibold text-xs text-brand-gold uppercase tracking-widest">Verification Documents</h3>
        <p class="font-display font-bold text-xl text-white uppercase tracking-wider">Official Quality Certificates</p>
      </div>

      <!-- Certificate Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 max-w-4xl mx-auto">
        
        <!-- ISO Certificate Card -->
        <div 
          class="cert-card group relative cursor-pointer overflow-hidden border border-brand-gold/20 hover:border-brand-gold/60 bg-brand-dark/50 p-4 shadow-xl transition-all duration-500 hover:scale-[1.03]"
          data-cert="/images/cert_iso.png"
          data-title="ISO 9001:2015 Quality Management Certificate"
        >
          <div class="relative overflow-hidden aspect-[3/4] border border-white/5 bg-brand-charcoal">
            <img 
              src="/images/cert_iso.png" 
              alt="ISO 9001:2015 Quality Management Certificate Document" 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <!-- Dark Overlay Hover state -->
            <div class="absolute inset-0 bg-brand-dark/90 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-6 text-center">
              <div class="p-3 bg-brand-charcoal text-brand-gold border border-brand-gold/30 rounded-full mb-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                </svg>
              </div>
              <span class="text-brand-gold font-display font-bold text-xs uppercase tracking-wider">View ISO Certificate</span>
              <span class="text-[9px] text-brand-light/50 uppercase tracking-widest mt-1 font-light">Quality Standards Compliant</span>
            </div>
          </div>
          <div class="pt-4 text-center">
            <h4 class="font-display font-bold text-sm text-white tracking-wide uppercase">ISO 9001:2015</h4>
            <p class="text-[10px] text-brand-light/50 uppercase tracking-widest mt-1">Quality Management System</p>
          </div>
        </div>

        <!-- CE Certificate Card -->
        <div 
          class="cert-card group relative cursor-pointer overflow-hidden border border-brand-gold/20 hover:border-brand-gold/60 bg-brand-dark/50 p-4 shadow-xl transition-all duration-500 hover:scale-[1.03]"
          data-cert="/images/cert_ce.png"
          data-title="CE Declaration of Conformity Certificate"
        >
          <div class="relative overflow-hidden aspect-[3/4] border border-white/5 bg-brand-charcoal">
            <img 
              src="/images/cert_ce.png" 
              alt="CE Declaration of Conformity Certificate Document" 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <!-- Dark Overlay Hover state -->
            <div class="absolute inset-0 bg-brand-dark/90 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-6 text-center">
              <div class="p-3 bg-brand-charcoal text-brand-gold border border-brand-gold/30 rounded-full mb-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                </svg>
              </div>
              <span class="text-brand-gold font-display font-bold text-xs uppercase tracking-wider">View CE Certificate</span>
              <span class="text-[9px] text-brand-light/50 uppercase tracking-widest mt-1 font-light">European Standards Certified</span>
            </div>
          </div>
          <div class="pt-4 text-center">
            <h4 class="font-display font-bold text-sm text-white tracking-wide uppercase">CE Declaration</h4>
            <p class="text-[10px] text-brand-light/50 uppercase tracking-widest mt-1">Conformité Européenne</p>
          </div>
        </div>

        <!-- Safety Standard Certificate Card -->
        <div 
          class="cert-card group relative cursor-pointer overflow-hidden border border-brand-gold/20 hover:border-brand-gold/60 bg-brand-dark/50 p-4 shadow-xl transition-all duration-500 hover:scale-[1.03]"
          data-cert="/images/cert_safety.png"
          data-title="Safety Standards Certificate (EN 81)"
        >
          <div class="relative overflow-hidden aspect-[3/4] border border-white/5 bg-brand-charcoal">
            <img 
              src="/images/cert_safety.png" 
              alt="Elevator Safety Standards Certificate Document" 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <!-- Dark Overlay Hover state -->
            <div class="absolute inset-0 bg-brand-dark/90 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-6 text-center">
              <div class="p-3 bg-brand-charcoal text-brand-gold border border-brand-gold/30 rounded-full mb-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                </svg>
              </div>
              <span class="text-brand-gold font-display font-bold text-xs uppercase tracking-wider">View Safety Certificate</span>
              <span class="text-[9px] text-brand-light/50 uppercase tracking-widest mt-1 font-light">Elevator Directive Compliant</span>
            </div>
          </div>
          <div class="pt-4 text-center">
            <h4 class="font-display font-bold text-sm text-white tracking-wide uppercase">EN 81 Directive</h4>
            <p class="text-[10px] text-brand-light/50 uppercase tracking-widest mt-1">Safety & Accessibility Norms</p>
          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- Interactive Lightbox Modal Component -->
  <div 
    id="cert-lightbox" 
    class="fixed inset-0 z-[100] hidden bg-brand-dark/95 backdrop-blur-md flex flex-col items-center justify-center p-4 sm:p-6 cursor-zoom-out select-none"
  >
    <!-- Close trigger -->
    <button 
      id="lightbox-close" 
      class="absolute top-6 right-6 text-brand-light/60 hover:text-brand-gold hover:scale-110 transition-all duration-300 cursor-pointer font-bold text-2xl font-mono p-2 focus:outline-none"
      aria-label="Close lightbox"
    >
      &times;
    </button>

    <div class="max-w-3xl w-full flex flex-col items-center cursor-default">
      <!-- Title -->
      <h3 id="lightbox-title" class="text-brand-gold font-display font-bold text-sm tracking-wider uppercase mb-4 text-center"></h3>
      
      <!-- High-res Image Wrapper -->
      <div class="relative border border-brand-gold/30 shadow-2xl bg-brand-charcoal overflow-hidden max-h-[75vh] flex items-center justify-center">
        <img 
          id="lightbox-img" 
          src="" 
          alt="High Resolution Certificate Document" 
          class="max-w-full max-h-[70vh] object-contain transition-transform duration-300 hover:scale-[1.02]"
        />
      </div>
      
      <!-- Subtitle -->
      <p id="lightbox-desc" class="text-brand-light/50 font-sans text-[10px] uppercase tracking-widest mt-4 text-center font-light">
        Press ESC or click anywhere outside the document to exit viewer.
      </p>
    </div>
  </div>
</section>

<!-- Lightbox interactivity script -->
<script>
  const setupLightbox = () => {
    const cards = document.querySelectorAll('.cert-card');
    const lightbox = document.getElementById('cert-lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxClose = document.getElementById('lightbox-close');

    if (cards.length > 0 && lightbox && lightboxImg && lightboxTitle && lightboxClose) {
      cards.forEach(card => {
        card.addEventListener('click', () => {
          const certUrl = card.getAttribute('data-cert');
          const certTitle = card.getAttribute('data-title');
          
          if (certUrl && certTitle) {
            lightboxImg.src = certUrl;
            lightboxTitle.textContent = certTitle;
            lightbox.classList.remove('hidden');
            document.body.style.overflow = 'hidden'; // prevent scroll
          }
        });
      });

      const closeLightbox = () => {
        lightbox.classList.add('hidden');
        document.body.style.overflow = ''; // restore scroll
      };

      lightboxClose.addEventListener('click', closeLightbox);
      lightbox.addEventListener('click', (e) => {
        // Close if click is on the outer lightbox overlay itself
        if (e.target === lightbox) {
          closeLightbox();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) {
          closeLightbox();
        }
      });
    }
  };

  setupLightbox();
  document.addEventListener('astro:after-swap', setupLightbox);
</script>
